JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Next.js expands $-prefixed sequences in .env files, which corrupts bcrypt hashes
# (they're full of "$2b$10$..."). Escape every literal $ as \$, e.g.:
#   ADMIN_PASSWORD_HASH=\$2b\$10\$abcxyz...
ADMIN_PASSWORD_HASH=

# Required: this app has no local filesystem storage fallback — all participant/response
# data is persisted in MongoDB. The connection string carries the DB user/password — get
# it from your cluster's "Connect" dialog (Atlas: Database > Connect > Drivers) and
# substitute in your real username/password. In production (e.g. Vercel), set this as a
# real environment variable in your host's project settings, not in a committed file.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?appName=<app-name>
# Database name to use within that cluster (kept separate from any other app sharing it).
MONGODB_DB_NAME=cognitiverhythm
